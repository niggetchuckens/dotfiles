# i3status configuration file
# Styled with Catppuccin color scheme definitions for minimalist setup

general {
        colors = true
        interval = 5
        color_good = "#a6e3a1"
        color_degraded = "#f9e2af"
        color_bad = "#f38ba8"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "memory"
order += "cpu_usage"
order += "volume master"
order += "tztime local"

wireless _first_ {
        format_up = " %quality (%essid)"
        format_down = " down"
}

ethernet _first_ {
        format_up = "󰈀 %ip (%speed)"
        format_down = "󰈀 down"
}

battery all {
        format = "%status %percentage"
        format_down = "No battery"
        status_chr = "⚡ CHR"
        status_bat = "󰁹 BAT"
        status_unk = "? UNK"
        status_full = "󰁹 FULL"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 10
}

memory {
        format = "󰍛 %used/%total"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

cpu_usage {
        format = " %usage"
}

volume master {
        format = " %volume"
        format_muted = " muted"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

tztime local {
        format = "󰃭 %Y-%m-%d %I:%M %p"
}
